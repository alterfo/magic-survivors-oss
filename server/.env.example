# Настройки серверов Magic Survivors. Скопируй в server/.env и загрузи в окружение: set -a; . server/.env; set +a
# База SQLite (игроки, кошельки, забеги). Каталог создаётся заранее: mkdir -p data
IDEAS_DB=data/ideas.db
IDEAS_PORT=8797
COOP_PORT=8798
COOP_HOST=127.0.0.1
# Соль для хэшей голосующих — поменяй на случайную строку
IDEAS_SALT=change-me
# Токен страницы онлайна /api/admin?key=... (пусто — страница выключена)
ADMIN_TOKEN=
# Админы чата: файл со списком id аккаунтов, по одному в строке (по умолчанию рядом с базой)
# ADMINS_FILE=data/admins.txt
# Вход через OAuth2-хаб (необязательно). Без HUB_CLIENT_SECRET вход выключен и играть можно гостем
HUB_URL=
HUB_CLIENT_ID=
HUB_CLIENT_SECRET=
GAME_URL=http://127.0.0.1:8088
LOGIN_REQUIRED=1
# Идеи игроков: 1 — сразу в голосование; синхронизация с GitHub issues по GITHUB_TOKEN и IDEAS_REPO (owner/repo)
IDEAS_AUTO_APPROVE=1
GITHUB_TOKEN=
IDEAS_REPO=
# Без аккаунтов: чат открыт всем (для локальной проверки)
CHAT_ANON=0
# Объявления в системном чате повторяются раз в столько секунд
ANNOUNCE_EVERY=900
# Осада города идёт всегда (локальная проверка)
SIEGE_TEST=0
